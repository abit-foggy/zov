// freestanding owned String: the platform supplies the buffer through
// compatibility alias String::from_owned and String.free reach zov_rt_free
export fn kmain() void = {
    let data: [4]u8 = [65u8, 66u8, 67u8, 68u8];
    let view: []u8 = data[..];
    let s = String::from_owned(view.ptr, 4usize, 4usize);
    s.free();
};
