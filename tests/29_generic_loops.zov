// generic instantiations must clone loop bodies, not drop them
use <stdio.h> as c;

export fn count_elems[T](items: []T) usize = {
    let mut n: usize = 0usize;
    for (let _x in items) {
        n += 1usize;
    };
    return n;
};

export fn sum_range[T](n: usize) usize = {
    let mut s: usize = 0usize;
    for (let i in 0..n) {
        s += i;
    };
    return s;
};

export fn main() i32 = {
    let nums: [4]i32 = [1, 2, 3, 4];
    let n = count_elems[i32](nums[..]);
    let s = sum_range[i32](4usize);
    c::printf("n=%lu s=%lu\n", n, s);
    if (n != 4usize) { return 1; };
    if (s != 6usize) { return 2; };
    return 0;
};
