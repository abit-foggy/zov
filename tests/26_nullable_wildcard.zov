// nullable wildcard arms cover both the null and non-null paths
use <stdio.h> as c;
use <stdlib.h> as s;

export fn classify(p: nullable *i8) i32 = {
    let tag: i32 = match (p) {
        case null => -1,
        case _ => 1,
    };
    return tag;
};

export fn wildcard_only(p: nullable *i8) i32 = {
    let tag: i32 = match (p) {
        case _ => 5,
    };
    return tag;
};

export fn main() i32 = {
    let missing = s::getenv("ZOV_SURELY_UNSET_VAR_123");
    let present = s::getenv("PATH");
    let a = classify(missing);
    let b = classify(present);
    let d = wildcard_only(missing);
    let e = wildcard_only(present);
    c::printf("a=%d b=%d d=%d e=%d\n", a, b, d, e);
    if (a != -1) { return 1; };
    if (b != 1) { return 2; };
    if (d != 5) { return 3; };
    if (e != 5) { return 4; };
    return 0;
};
