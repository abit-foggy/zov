// nullable wildcard arms cover both the null and non-null paths
use <stdio.h> as c;

export fn classify(p: nullable *c::FILE) i32 = {
    let tag: i32 = match (p) {
        case null => -1,
        case _ => 1,
    };
    return tag;
};

export fn wildcard_only(p: nullable *c::FILE) i32 = {
    let tag: i32 = match (p) {
        case _ => 5,
    };
    return tag;
};

export fn main() i32 = {
    let missing = c::fopen("/zov/definitely/missing/file", "r");
    let present = c::tmpfile();
    let fp: *c::FILE = present!;
    defer c::fclose(fp);
    let a = classify(missing);
    let b = classify(present);
    let d = wildcard_only(missing);
    let e = wildcard_only(present);
    c::printf("a=%d b=%d d=%d e=%d\n", a, b, d, e);
    if (a != -1) { return 1; };
    if (b != 1) { return 2; };
    if (d != 5) { return 3; };
    if (e != 5) { return 4; };
    return 0;
};
