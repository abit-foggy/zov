// overwrite assignment destroys the previous owned value in locals,
// struct fields, and tagged unions, and reinitializes moved/dropped places
use std::io;
use std::map;
use std::mem as mem;
use std::vec;

export type Holder = resource struct {
    label: String,
    id: i32,
};

export type Slot = (String | i32);

export fn main() i32 = {
    // local reassignment in a loop must release every previous buffer
    let mut s = String::from("zero");
    let mut i = 0;
    while (i < 200) {
        s = String::from("tick");
        i += 1;
    };
    io::println(s.view());
    s.free();

    // struct field reassignment destroys the old field exactly once
    let mut h = Holder{ label = String::from("a"), id = 1 };
    h.label = String::from("b");
    h.label = String::from("c");
    io::println(h.label.view());
    h.label.free();

    // moving a field out and reassigning it must not free the old handle
    let mut m = Holder{ label = String::from("moved"), id = 2 };
    let taken = m.label;
    m.label = String::from("fresh");
    io::println(taken.view());
    io::println(m.label.view());
    taken.free();
    m.label.free();

    // freeing a field and reassigning it reinitializes without a second free
    h.label = String::from("after-free");
    h.label.free();
    h.label = String::from("reborn");
    io::println(h.label.view());
    h.label.free();

    // union variant reassignment destroys only the active payload
    let mut u: Slot = String::from("first");
    u = String::from("second");
    u = String::from("third");
    u = 9;
    let n: i32 = match (u) {
        case let x: i32 => x,
        case String => -1,
    };
    if (n != 9) { return 1; };
    io::println("union ok");

    // a moved union payload is uninitialized; assign a fresh variant
    let mut u2: Slot = String::from("first-payload");
    let first_payload: String = match (u2) {
        case let s: String => s,
        case _ => String::new(),
    };
    u2 = String::from("second-payload");
    let second_payload: String = match (u2) {
        case let s: String => s,
        case _ => String::new(),
    };
    first_payload.free();
    second_payload.free();

    // assignment after a move or drop reinitializes without a free
    let mut r = String::from("moved-away");
    let old = r;
    r = String::from("back");
    io::println(r.view());
    old.free();
    r.free();

    let mut d = String::from("dropped");
    mem::drop(d);
    d = String::from("again");
    io::println(d.view());
    d.free();

    // container locals overwrite through their free() hook
    let mut v = vec::new[String]();
    v.push(String::from("old-element"));
    v = vec::new[String]();
    v.push(String::from("new-element"));
    v.free();

    let mut table = map::new[str, String]();
    table.insert("old", String::from("old-value"));
    table = map::new[str, String]();
    table.insert("new", String::from("new-value"));
    table.free();
    return 0;
};
