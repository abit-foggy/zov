// std::arena bump allocation, std::str utilities, Vec::asslice
use std::arena as arena;
use std::str as strlib;
use std::vec as vec;
use std::io;

export fn main() i32 = {
    let mut a = arena::new(256usize);
    defer a.free();
    let p = a.allocbytes(4usize);
    let q = a.allocbytes(8usize);
    assert(p != q);
    a.reset();
    assert(a.offset == 0usize);

    let padded: str = "  padded  ";
    let t = strlib::trim(padded);
    assert(t == "padded");
    io::println("trimmed=[{t}]");
    assert(strlib::startswith("zovlang", "zov"));
    assert(strlib::endswith("zovlang", "lang"));
    let r = strlib::findbyte("main.zov", 46u8);
    let dot: usize = match (r) {
        case let i: usize => i,
        case strlib::NotFound => 99usize,
    };
    assert(dot == 4usize);

    let mut v = vec::new[i32]();
    for (let i in 0..5) {
        v.push(i + 1);
    };
    let sl = v.asslice();
    assert(sl.len == 5usize);
    let mut total = 0;
    for (let x in sl) {
        total = total + x;
    };
    io::println("slice sum={total}");
    // NLL: sl's last use is above, so the loan on v has expired here
    v.push(6);
    v.free();
    return 0;
};
