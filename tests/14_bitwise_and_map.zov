// bitwise ops, compound assignments, std::env, and Map[str, i32]
use std::env as env;
use std::map as map;
use std::io;

export fn main() i32 = {
    let a: u32 = 0xF0F0u32;
    let b: u32 = 0x0FF0u32;
    assert((a & b) == 0x00F0u32);
    assert((a | b) == 0xFFF0u32);
    assert((a ^ b) == 0xFF00u32);
    assert((~a & 0xFFFFu32) == 0x0F0Fu32);
    assert((1u32 << 6) == 64u32);
    assert((0x4000u32 >> 6) == 256u32);

    let mut x: i32 = 7;
    x += 3;
    x *= 4;
    x -= 10;
    x /= 2;
    x %= 7;
    x |= 40;
    x &= 63;
    x ^= 2;
    x <<= 3;
    x >>= 1;
    io::println("x={x}");
    assert(x == 172);

    let n = env::args_count();
    assert(n >= 1usize);
    let prog = env::arg_at(0usize);
    io::println("argv0 non-empty={prog.len > 0usize}");

    let mut m = map::new[str, i32]();
    defer m.free();
    let mut i: i32 = 0;
    while (i < 60) {
        m.insert("k", i);
        m.insert("k", i);
        i += 1;
    };
    assert(m.len() == 1usize);
    let mut j: i32 = 0;
    let keys: [3]str = ["alpha", "beta", "gamma"];
    while (j < 3) {
        let key: str = keys[j as usize];
        m.insert(key, j * 100);
        j += 1;
    };
    assert(m.len() == 4usize);
    let beta = m.get("beta");
    let bv: i32 = match (beta) {
        case let v: i32 => v,
        case map::MapNotFound => -1,
    };
    io::println("beta={bv}");
    assert(bv == 100);
    assert(m.contains("gamma"));
    assert(!m.contains("delta"));
    assert(m.remove("alpha"));
    assert(m.len() == 3usize);
    assert(!m.remove("alpha"));
    return 0;
};
