// union-typed struct fields: construction, assignment, and owned payloads
use std::io;

export type Oops = !void;

export type Holder = resource struct {
    num: (i32 | Oops),
    val: (String | Oops),
    id: i32,
};

fn measure(s: String) i32 = {
    let n: i32 = s.len() as i32;
    s.free();
    return n;
};

fn total(h: Holder) i32 = {
    let a: i32 = match (h.num) {
        case let v: i32 => v,
        case Oops => -1,
    };
    let b: i32 = match (h.val) {
        case let s: String => measure(s),
        case Oops => -1,
    };
    return a + b + h.id;
};

export fn main() i32 = {
    let mut h = Holder{ num = 7, val = String::from("abc"), id = 5 };
    h.num = 42;
    let c: i32 = match (h.num) {
        case let v: i32 => v,
        case Oops => -1,
    };
    let t = total(h);

    let mut u: (i32 | Oops) = Oops;
    u = c;
    let d: i32 = match (u) {
        case let v: i32 => v,
        case Oops => -1,
    };

    io::println("c={c} t={t} d={d}");
    if (c != 42) { return 1; };
    if (t != 50) { return 2; };
    if (d != 42) { return 3; };
    return 0;
};
