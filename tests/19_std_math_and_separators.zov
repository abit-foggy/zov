use std::math;

export fn main() i32 = {
    let million = 1_000_000;
    if (million != 1000000) { return 1; };
    let hexmask = 0xff_ff;
    if (hexmask != 65535) { return 2; };
    let pi = 3.141_592f64;
    if (pi < 3.14f64 || pi > 3.15f64) { return 3; };
    let big = 1_000_000_000usize;
    if (big != 1000000000usize) { return 4; };
    if (math::clamp(15, 0, 10) != 10) { return 5; };
    if (math::clamp(-5, 0, 10) != 0) { return 6; };
    if (math::clamp(5, 0, 10) != 5) { return 7; };
    if (math::abs(-42) != 42) { return 8; };
    if (math::abs(42) != 42) { return 9; };
    if (math::min(3, 7) != 3) { return 10; };
    if (math::max(3, 7) != 7) { return 11; };
    if (math::sqrt(16.0f64) != 4.0f64) { return 12; };
    if (math::pow(2.0f64, 10.0f64) != 1024.0f64) { return 13; };
    if (math::floor(3.7f64) != 3.0f64) { return 14; };
    if (math::ceil(3.2f64) != 4.0f64) { return 15; };
    if (math::round(2.5f64) != 3.0f64) { return 16; };
    if (math::fclamp(15.0f64, 0.0f64, 10.0f64) != 10.0f64) { return 17; };
    if (math::popcnt(0xffu32) != 8) { return 18; };
    if (math::popcnt(0u32) != 0) { return 19; };
    if (math::nextpow2(100u32) != 128u32) { return 20; };
    if (math::nextpow2(1u32) != 1u32) { return 21; };
    let r = math::randint(5, 5);
    if (r != 5) { return 22; };
    return 0;
};
