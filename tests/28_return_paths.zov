// both branches and exhaustive match arms count as returning on all paths
use <stdio.h> as c;

export type Eof = !void;

export fn sign(x: i32) i32 = {
    if (x > 0) {
        return 1;
    } else if (x < 0) {
        return -1;
    } else {
        return 0;
    };
};

export fn classify(v: (i32 | Eof)) i32 = {
    match (v) {
        case let n: i32 => return n,
        case Eof => return 0,
    };
};

export fn main() i32 = {
    let a = sign(5);
    let b = sign(-5);
    let d = sign(0);
    let e = classify(9);
    let f = classify(Eof);
    c::printf("a=%d b=%d d=%d e=%d f=%d\n", a, b, d, e, f);
    if (a != 1) { return 1; };
    if (b != -1) { return 2; };
    if (d != 0) { return 3; };
    if (e != 9) { return 4; };
    if (f != 0) { return 5; };
    return 0;
};
