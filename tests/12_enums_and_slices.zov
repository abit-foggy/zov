// enums, variant-name printing, value match, slicing, and slice for-each
export type Color = enum {
    Red,
    Green,
    Blue = 10,
};

export fn main() i32 = {
    let c = Color::Blue;
    println("c={c}");
    match (c) {
        case Color::Red => return 1,
        case Color::Green => return 2,
        case Color::Blue => println("matched blue"),
    };

    let cmd: str = "start";
    match (cmd) {
        case "start" => println("starting"),
        case "stop" => println("stopping"),
        case _ => println("unknown"),
    };

    let s: str = "hello zov world";
    let head: str = s[0..5];
    let tail: str = s[6..];
    println("head={head} tail={tail}");

    let nums: [4]i32 = [10, 20, 30, 40];
    for (let x in nums[..]) {
        println("item={x}");
    };
    let mid = nums[1..3];
    println("mid.len={mid.len}");
    let mut sum = 0;
    for (let x in mid) {
        sum = sum + x;
    };
    println("mid sum={sum}");

    let mut bytes = 0;
    for (let b in "AZ") {
        bytes = bytes + (b as i32);
    };
    println("bytes={bytes}");
    return 0;
};
