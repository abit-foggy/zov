use std::io;

// enums, variant-name printing, value match, slicing, and slice for-each
export type Color = enum {
    Red,
    Green,
    Blue = 10,
};

export fn main() i32 = {
    let c = Color::Blue;
    io::println("c={c}");
    match (c) {
        case Color::Red => return 1,
        case Color::Green => return 2,
        case Color::Blue => io::println("matched blue"),
    };

    let cmd: str = "start";
    match (cmd) {
        case "start" => io::println("starting"),
        case "stop" => io::println("stopping"),
        case _ => io::println("unknown"),
    };

    let s: str = "hello zov world";
    let head: str = s[0..5];
    let tail: str = s[6..];
    io::println("head={head} tail={tail}");

    let nums: [4]i32 = [10, 20, 30, 40];
    for (let x in nums[..]) {
        io::println("item={x}");
    };
    let mid = nums[1..3];
    io::println("mid.len={mid.len}");
    let mut sum = 0;
    for (let x in mid) {
        sum = sum + x;
    };
    io::println("mid sum={sum}");

    let mut bytes = 0;
    for (let b in "AZ") {
        bytes = bytes + (b as i32);
    };
    io::println("bytes={bytes}");
    return 0;
};
