// freestanding smoke kernel: bare-metal entry, panic-routed assert,
// and slice bounds checking with zero hosted libc references
export fn kmain() void = {
    let boot_ok: bool = true;
    assert(boot_ok);
    let magic: u32 = 0x2BADB002u32;
    let low: u32 = magic & 0xFFFFu32;
    assert(low == 0xB002u32);
};

export fn early_stack_probe(base: *u8) u8 = {
    let view = base[0..4usize];
    return view.ptr[0usize];
};
