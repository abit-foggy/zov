use std::io;
use std::mem as mem;

export fn main() i32 = {
    io::println("io online");
    let r = io::readline();
    let line: str = match (r) {
        case let s: str => s,
        case IoError => "eof",
    };
    io::print("echo:");
    io::println(line);
    let n = 5;
    io::println(n);
    io::println(3.5f64);
    io::println(true);
    io::println('Z');
    std::io::println("full path works");
    let scratch: *u8 = mem::alloc[u8](4usize);
    mem::free_ptr(scratch);
    return 0;
};
