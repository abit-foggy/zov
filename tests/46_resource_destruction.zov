// resource destruction: mem::drop releases owned fields and the active
// union payload; vector free releases every live element
use std::vec as vec;
use std::map as map;
use std::mem as mem;
use std::io;

export type Oops = !void;

export type Holder = struct {
    label: String,
    id: i32,
};

export type Outer = struct {
    inner: Holder,
    tail: String,
};

export fn main() i32 = {
    let mut v = vec::new[String]();
    v.push(String::from("alpha"));
    v.push(String::from("beta"));
    v.free();

    let mut names = vec::new[String]();
    names.push(String::from("a"));
    names.push(String::from("c"));
    names.insert(1usize, String::from("b"));
    assert(names.len() == 3usize);
    assert(names.get(1usize).view() == "b");
    let old = names.replace(0usize, String::from("A"));
    assert(old.view() == "a");
    old.free();
    let last = names.pop();
    let lv: String = match (last) {
        case let s: String => s,
        case Empty => return 2,
    };
    assert(lv.view() == "c");
    lv.free();
    let removed = names.remove(0usize);
    assert(removed.view() == "A");
    removed.free();
    assert(names.len() == 1usize);
    names.set(0usize, String::from("B"));
    names.clear();
    assert(names.len() == 0usize);
    names.free();

    let h = Holder{ label = String::from("holder"), id = 4 };
    mem::drop(h);

    let u: (String | Oops) = String::from("union");
    mem::drop(u);

    let o = Outer{
        inner = Holder{ label = String::from("nested"), id = 8 },
        tail = String::from("tail"),
    };
    mem::drop(o);

    let hu: (Holder | Oops) = Holder{ label = String::from("payload"),
                                      id = 9 };
    mem::drop(hu);

    let mut m = map::new[str, String]();
    m.insert("a", String::from("one"));
    m.insert("b", String::from("two"));
    m.insert("a", String::from("three"));
    assert(m.len() == 2usize);
    assert(m.remove("b"));
    assert(!m.contains("b"));
    m.free();

    let mut m2 = map::new[str, String]();
    m2.insert("k", String::from("value"));
    let r = m2.take("k");
    let got: String = match (r) {
        case let s: String => s,
        case MapNotFound => return 1,
    };
    assert(got.view() == "value");
    got.free();
    assert(m2.len() == 0usize);
    m2.free();

    let n: i32 = 5;
    mem::drop(n); // trivially destructible values are a no-op
    io::println("resource destruction ok");
    return 0;
};
