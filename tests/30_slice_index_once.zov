// the slice base of an index expression is evaluated exactly once
use <stdio.h> as c;

export fn make(a: *i32, calls: &mut i32) []i32 = {
    *calls = *calls + 1;
    return a[0..4];
};

export fn main() i32 = {
    let nums: [4]i32 = [10, 20, 30, 40];
    let mut calls: i32 = 0;
    let v = make((&nums[0]) as *i32, &mut calls)[2usize];
    c::printf("v=%d calls=%d\n", v, calls);
    if (v != 30) { return 1; };
    if (calls != 1) { return 2; };
    return 0;
};
