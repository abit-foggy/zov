export type NotFound = !void;

// all utilities are zero-allocation: results are sub-slices of the input
export fn eq(a: str, b: str) bool = {
    return a == b;
};

export fn starts_with(s: str, prefix: str) bool = {
    if (s.len < prefix.len) { return false; };
    let head: str = s[0..prefix.len];
    return head == prefix;
};

export fn ends_with(s: str, suffix: str) bool = {
    if (s.len < suffix.len) { return false; };
    let start: usize = s.len - suffix.len;
    let tail: str = s[start..];
    return tail == suffix;
};

export fn find_byte(s: str, ch: u8) (usize | NotFound) = {
    for (let i in 0..s.len) {
        if (s.ptr[i] == ch) { return i; };
    };
    return NotFound;
};

export fn trim(s: str) str = {
    let mut start: usize = 0usize;
    let mut end: usize = s.len;
    while (start < end) {
        let ch: u8 = s.ptr[start];
        if (ch == 32u8 || ch == 9u8 || ch == 10u8 || ch == 13u8) {
            start = start + 1usize;
        } else {
            break;
        };
    };
    while (end > start) {
        let ch: u8 = s.ptr[end - 1usize];
        if (ch == 32u8 || ch == 9u8 || ch == 10u8 || ch == 13u8) {
            end = end - 1usize;
        } else {
            break;
        };
    };
    return s[start..end];
};

test "starts_with and trim" {
    let s: str = "  hello  ";
    let t = trim(s);
    assert(t == "hello");
    assert(starts_with("zovlang", "zov"));
    assert(ends_with("zovlang", "lang"));
};

test "find_byte" {
    let path: str = "main.zov";
    let r = find_byte(path, 46u8);
    let dot: usize = match (r) {
        case let i: usize => i,
        case NotFound => 99usize,
    };
    assert(dot == 4usize);
};
