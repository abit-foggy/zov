// Hosted-only: splitting returns Vec[str], so it needs std::vec and an
// allocator.  std::str keeps the zero-allocation queries for kernels.
use std::vec as vec;

// zero-copy split: pieces are sub-slices of the original
export fn splitbyte(s: str, delim: u8) vec::Vec[str] = {
    let mut out = vec::new[str]();
    let mut start: usize = 0usize;
    let mut i: usize = 0usize;
    while (i < s.len) {
        if (s.ptr[i] == delim) {
            out.push(s[start..i]);
            start = i + 1usize;
        };
        i += 1usize;
    };
    out.push(s[start..s.len]);
    return out;
};

// splits on LF, stripping one trailing CR per line
export fn lines(s: str) vec::Vec[str] = {
    let mut out = splitbyte(s, 10u8);
    let mut i: usize = 0usize;
    while (i < out.len()) {
        let line: str = out.get(i);
        if (line.len > 0usize
            && line.ptr[line.len - 1usize] == 13u8) {
            out.set(i, line[0..(line.len - 1usize)]);
        };
        i += 1usize;
    };
    return out;
};
