use <stdio.h> as c;
use <unistd.h> as u;
use <sys/stat.h> as st;
use <dirent.h> as d;

use std::mem as mem;

export type FsError = !i32;

// Reads the whole file into an owned String.  The caller must free it.
export fn readstr(path: str) (String | FsError) = {
    let raw: nullable *c::FILE = c::fopen(path, "rb");
    let fp: *c::FILE = match (raw) {
        case null => return 1,
        case let p: *c::FILE => p,
    };
    defer c::fclose(fp);
    c::fseek(fp, 0, c::SEEK_END);
    let size: i64 = c::ftell(fp);
    if (size < 0i64) {
        return 2;
    };
    c::fseek(fp, 0, c::SEEK_SET);
    let cap: usize = (size as usize) + 1usize;
    let buf: *u8 = mem::alloc[u8](cap);
    let n = c::fread(buf as *void, 1usize, size as usize, fp);
    return String::fromowned(buf, n, cap);
};

export fn writestr(path: str, content: str) (void | FsError) = {
    let raw: nullable *c::FILE = c::fopen(path, "w");
    let fp: *c::FILE = match (raw) {
        case null => return 1,
        case let p: *c::FILE => p,
    };
    defer c::fclose(fp);
    c::fwrite(content.data as *void, 1usize, content.len, fp);
    return;
};

// NUL-terminated copy for POSIX calls; the caller frees it.
fn dupz(s: str) *u8 = {
    let p: *u8 = mem::alloc[u8](s.len + 1usize);
    let mut i: usize = 0usize;
    while (i < s.len) {
        p[i] = s.data[i];
        i += 1usize;
    };
    p[s.len] = 0u8;
    return p;
};

export fn exists(path: str) bool = {
    let p: *u8 = dupz(path);
    let rc: i32 = u::access(p as *void, 0);
    mem::freeptr[u8](p);
    return rc == 0;
};

export fn isdir(path: str) bool = {
    let p: *u8 = dupz(path);
    defer mem::freeptr[u8](p);
    let raw: nullable *d::DIR = d::opendir(p as *void);
    if (raw == null) { return false; };
    let dirp: *d::DIR = raw!;
    d::closedir(dirp);
    return true;
};

export fn isfile(path: str) bool = {
    return exists(path) && !isdir(path);
};

export fn remove(path: str) bool = {
    let p: *u8 = dupz(path);
    let rc: i32 = u::unlink(p as *void);
    mem::freeptr[u8](p);
    return rc == 0;
};

export fn rmdir(path: str) bool = {
    let p: *u8 = dupz(path);
    let rc: i32 = u::rmdir(p as *void);
    mem::freeptr[u8](p);
    return rc == 0;
};

export fn mkdir(path: str) bool = {
    let p: *u8 = dupz(path);
    let rc: i32 = st::mkdir(p as *void, 493);
    mem::freeptr[u8](p);
    return rc == 0;
};

export fn rename(oldpath: str, newpath: str) bool = {
    let a: *u8 = dupz(oldpath);
    let b: *u8 = dupz(newpath);
    let rc: i32 = c::rename(a as *void, b as *void);
    mem::freeptr[u8](a);
    mem::freeptr[u8](b);
    return rc == 0;
};
