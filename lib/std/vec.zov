use std::mem as mem;
use <stdlib.h> as c;

// resource: Vec moves are tracked by the Phase 3 borrow checker, which
// prevents double-frees and use-after-move at compile time
export type Vec[T] = resource struct {
    data: nullable *T,
    length: usize,
    cap: usize,
};

export fn new[T]() Vec[T] = {
    return Vec[T]{ data = null, length = 0usize, cap = 0usize };
};

export fn (self: &mut Vec[T]) push(val: T) void = {
    if (self.length == self.cap) {
        let new_cap: usize = (self.cap * 2usize) + 1usize;
        if (self.data == null) {
            self.data = mem::alloc[T](new_cap);
        } else {
            let p: *T = self.data!;
            self.data = mem::realloc_buf[T](p, new_cap);
        };
        self.cap = new_cap;
    };
    let d: *T = self.data!;
    d[self.length] = val;
    self.length = self.length + 1usize;
};

export fn (self: &Vec[T]) get(idx: usize) T = {
    if (idx >= self.length) { c::abort(); };
    let d: *T = self.data!;
    return d[idx];
};

export fn (self: &mut Vec[T]) set(idx: usize, val: T) void = {
    if (idx >= self.length) { c::abort(); };
    let d: *T = self.data!;
    d[idx] = val;
};

export fn (self: &Vec[T]) len() usize = {
    return self.length;
};

export fn (self: Vec[T]) free() void = {
    if (self.data == null) { return; };
    let d: *T = self.data!;
    mem::free_ptr[T](d);
};
