use <math.h> as cmath;
use <stdlib.h> as cstdlib;

export fn min(a: i32, b: i32) i32 = {
    if (a < b) { return a; };
    return b;
};

export fn max(a: i32, b: i32) i32 = {
    if (a > b) { return a; };
    return b;
};

export fn clamp(val: i32, lo: i32, hi: i32) i32 = {
    if (val < lo) { return lo; };
    if (val > hi) { return hi; };
    return val;
};

export fn abs(x: i32) i32 = {
    if (x < 0) { return -x; };
    return x;
};

export fn randint(lo: i32, hi: i32) i32 = {
    return lo + (cstdlib::rand() % (hi - lo + 1));
};

export fn popcnt(x: u32) i32 = {
    let mut n: i32 = 0;
    let mut v: u32 = x;
    while (v != 0u32) {
        n += (v & 1u32) as i32;
        v = v >> 1u32;
    };
    return n;
};

export fn nextpow2(x: u32) u32 = {
    if (x <= 1u32) { return 1u32; };
    let mut v: u32 = x - 1u32;
    v = v | (v >> 1u32);
    v = v | (v >> 2u32);
    v = v | (v >> 4u32);
    v = v | (v >> 8u32);
    v = v | (v >> 16u32);
    return v + 1u32;
};

export fn fmin(a: f64, b: f64) f64 = {
    return cmath::fmin(a, b);
};

export fn fmax(a: f64, b: f64) f64 = {
    return cmath::fmax(a, b);
};

export fn fclamp(val: f64, lo: f64, hi: f64) f64 = {
    return cmath::fmin(cmath::fmax(val, lo), hi);
};

export fn fabs(x: f64) f64 = {
    return cmath::fabs(x);
};

// Portable square root: scale into [1, 4] by powers of four, run a
// Newton iteration, then undo the scale.  No libm dependency, so kernels
// and other freestanding builds can use it.
export fn sqrt(x: f64) f64 = {
    if (x <= 0.0f64) { return 0.0f64; };
    let mut scaled: f64 = x;
    let mut scale: f64 = 1.0f64;
    while (scaled < 1.0f64) {
        scaled = scaled * 4.0f64;
        scale = scale * 2.0f64;
    };
    while (scaled > 4.0f64) {
        scaled = scaled / 4.0f64;
        scale = scale / 2.0f64;
    };
    let mut g: f64 = scaled / 2.0f64;
    let mut i: i32 = 0;
    while (i < 30) {
        g = 0.5f64 * (g + scaled / g);
        i += 1;
    };
    return g / scale;
};

export fn pow(x: f64, y: f64) f64 = {
    return cmath::pow(x, y);
};

export fn floor(x: f64) f64 = {
    return cmath::floor(x);
};

export fn ceil(x: f64) f64 = {
    return cmath::ceil(x);
};

export fn round(x: f64) f64 = {
    return cmath::round(x);
};

export fn sin(x: f64) f64 = {
    return cmath::sin(x);
};

export fn cos(x: f64) f64 = {
    return cmath::cos(x);
};

export fn tan(x: f64) f64 = {
    return cmath::tan(x);
};
