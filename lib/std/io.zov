use <stdio.h> as c;

use <unistd.h> as u;

use std::mem as mem;

// Distinct variants: a blank line is a String of length 0, Eof means no
// bytes remained, and IoError carries the read failure code.
export type Eof = !void;
export type IoError = !i32;

// one line from stdin; trailing \n and \r are stripped.  The returned
// String owns its buffer and the caller must release it with free().
export fn readline() (String | Eof | IoError) = {
    let mut cap: usize = 256usize;
    let mut buf: *u8 = mem::alloc[u8](cap);
    let one: [1]u8;
    let mut len: usize = 0usize;
    let mut got: bool = false;
    while (true) {
        let n = u::read(0, (&one[0usize]) as *void, 1usize);
        if (n < 0i64) {
            mem::freeptr[u8](buf);
            return 1;
        };
        if (n == 0i64) {
            break;
        };
        got = true;
        if (one[0usize] == 10u8) {
            break;
        };
        if (len == cap) {
            if (cap > 1073741824usize) {
                mem::freeptr[u8](buf);
                return 2;
            };
            cap = cap * 2usize;
            buf = mem::reallocbuf[u8](buf, cap);
        };
        buf[len] = one[0usize];
        len += 1usize;
    };
    if (!got) {
        mem::freeptr[u8](buf);
        return Eof;
    };
    if (len > 0usize && buf[len - 1usize] == 13u8) {
        len -= 1usize;
    };
    return String::fromowned(buf, len, cap);
};

// Streaming fallback for non-specialized callers.  The compiler lowers
// ordinary io::print/println calls directly and does not allocate here.
export fn print[T](msg: T) void = {
    let s = "" + msg;
    let v: str = s.view();
    c::fwrite(v.data as *void, 1usize, v.len, c::stdout);
    s.free();
};

// forces pending stdout bytes to reach the terminal
export fn flush() void = {
    c::fflush(c::stdout);
};

export fn println[T](msg: T) void = {
    print(msg);
    c::putchar(10);
};
