use <stdio.h> as c;

use <unistd.h> as u;

use std::mem as mem;

export type IoError = !void;

// one line from stdin; trailing \n and \r are stripped, 255 bytes max
export fn readline() str = {
    let cap: usize = 256usize;
    let buf: *u8 = mem::alloc[u8](cap);
    let one: [1]u8;
    let mut len: usize = 0usize;
    let mut got: bool = false;
    while (len < cap - 1usize) {
        let n = u::read(0, (&one[0usize]) as *void, 1usize);
        if (n != 1i64) {
            break;
        };
        got = true;
        if (one[0usize] == 10u8) {
            break;
        };
        buf[len] = one[0usize];
        len += 1usize;
    };
    if (!got) {
        mem::free_ptr[u8](buf);
        return "";
    };
    if (len > 0usize && buf[len - 1usize] == 13u8) {
        len -= 1usize;
    };
    return zov_str_from_raw(buf, len);
};

// renders any printable value: '' + msg builds its str form
export fn print[T](msg: T) void = {
    let s: str = "" + msg;
    let mut i: usize = 0usize;
    while (i < s.len) {
        c::putchar(s.ptr[i] as i32);
        i += 1usize;
    };
};

// forces pending stdout bytes to reach the terminal
export fn flush() void = {
    c::fflush(c::stdout);
};

export fn println[T](msg: T) void = {
    print(msg);
    c::putchar(10);
};
