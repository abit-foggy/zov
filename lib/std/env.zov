use <stdlib.h> as c;
use <unistd.h> as u;

use std::mem as mem;

export type EnvNotFound = !void;

// argv zero-copy: slices point straight into the C argv strings
export fn argscount() usize = {
    return zov_env_args_count();
};

export fn argat(idx: usize) str = {
    return zov_env_arg_at(idx);
};

export fn get(name: str) (str | EnvNotFound) = {
    if (!zov_env_has(name)) {
        return EnvNotFound;
    };
    return zov_env_get_str(name);
};

// Owned variant: the bytes survive later set/unset calls.  Free the String.
export fn getstr(name: str) (String | EnvNotFound) = {
    let v = get(name);
    let s: str = match (v) {
        case let x: str => x,
        case EnvNotFound => return EnvNotFound,
    };
    return String::from(s);
};

// NUL-terminated copy for C calls; free with mem::freeptr[u8].
export fn dupz(s: str) *u8 = {
    let p: *u8 = mem::alloc[u8](s.len + 1usize);
    let mut i: usize = 0usize;
    while (i < s.len) {
        p[i] = s.data[i];
        i += 1usize;
    };
    p[s.len] = 0u8;
    return p;
};

export fn set(name: str, value: str) bool = {
    let n: *u8 = dupz(name);
    let v: *u8 = dupz(value);
    let rc: i32 = c::setenv(n as *void, v as *void, 1);
    mem::freeptr[u8](n);
    mem::freeptr[u8](v);
    return rc == 0;
};

export fn unset(name: str) bool = {
    let n: *u8 = dupz(name);
    let rc: i32 = c::unsetenv(n as *void);
    mem::freeptr[u8](n);
    return rc == 0;
};

// Real process working directory as an owned String.  Free the result.
export fn cwd() (String | EnvNotFound) = {
    let mut cap: usize = 256usize;
    while (cap <= 1048576usize) {
        let buf: *u8 = mem::alloc[u8](cap);
        let got: nullable *i8 = u::getcwd(buf as *void, cap) as nullable *i8;
        if (got != null) {
            let mut n: usize = 0usize;
            while (buf[n] != 0u8) { n += 1usize; };
            return String::from_owned(buf, n, cap);
        };
        mem::freeptr[u8](buf);
        if (cap > 524288usize) { break; };
        cap = cap * 2usize;
    };
    return EnvNotFound;
};

export fn chdir(path: str) bool = {
    let p: *u8 = dupz(path);
    let rc: i32 = u::chdir(p as *void);
    mem::freeptr[u8](p);
    return rc == 0;
};

test "argv is visible" {
    let n = argscount();
    assert(n >= 1usize);
    let prog = argat(0usize);
    assert(prog.len > 0usize);
};
