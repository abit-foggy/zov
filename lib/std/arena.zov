use std::mem as mem;
use <stdlib.h> as c;

// resource: moves are tracked; a moved Arena cannot be reused or freed twice
export type Arena = resource struct {
    buf: nullable *u8,
    cap: usize,
    offset: usize,
};

export fn new(cap: usize) Arena = {
    return Arena{ buf = mem::alloc[u8](cap), cap = cap, offset = 0usize };
};

export fn (self: &mut Arena) alloc_bytes(size: usize) *u8 = {
    // proper 8-byte alignment: round the end up past the request
    let start: usize = (self.offset + 7usize) & (~7usize);
    let end: usize = start + size;
    if (end > self.cap) { c::abort(); };
    self.offset = end;
    let d: *u8 = self.buf!;
    return ((&d[start]) as *u8);
};

export fn (self: &mut Arena) reset() void = {
    self.offset = 0usize;
};

export fn (self: Arena) free() void = {
    if (self.buf == null) { return; };
    let d: *u8 = self.buf!;
    mem::free_ptr[u8](d);
};

test "arena bump and reset" {
    let mut a = new(1024usize);
    let p = a.alloc_bytes(5usize);
    let first: usize = a.offset;
    let q = a.alloc_bytes(3usize);
    let second: usize = a.offset;
    assert(second > first);
    assert(q != p);
    a.reset();
    assert(a.offset == 0usize);
    a.free();
};
