{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zov",
  "scopeName": "source.zov",
  "fileTypes": ["zov"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#literals" },
    { "include": "#punctuation" },
    { "name": "meta.function.zov", "begin": "(\\bfn\\b)", "end": "(?=\\{)", "beginCaptures": { "1": { "name": "keyword.other.fn.zov" } }, "patterns": [
      { "name": "entity.name.function.zov", "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b" },
      { "include": "#parameters" }
    ]},
    { "name": "meta.type.zov", "begin": "\\b(type)\\b", "end": "(?==)", "beginCaptures": { "1": { "name": "storage.type.zov" } }, "patterns": [
      { "name": "entity.name.type.zov", "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b" },
      { "match": "\\[([a-zA-Z_,\\s]+)\\]", "name": "meta.generic.zov", "captures": { "1": { "name": "storage.type.generic.zov" } }}
    ]},
    { "name": "variable.other.zov", "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b(?=\\s*;)" },
    { "name": "meta.call.zov", "match": "\\b([a-z_][a-zA-Z0-9_]*(?:::[a-z_][a-zA-Z0-9_]*)*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.call.zov" }}},
    { "name": "meta.method.zov", "match": "\\.([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.method.zov" }}},
    { "name": "meta.member.zov", "match": "\\.([a-z_][a-zA-Z0-9_]*)", "captures": { "1": { "name": "variable.other.member.zov" }}},
    { "name": "entity.name.namespace.zov", "match": "\\b([a-z_][a-zA-Z0-9_]*)::" },
    { "name": "variable.other.zov", "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zov",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.zov",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zov",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zov",
              "match": "\\\\(x[0-9a-fA-F]{2}|.)"
            },
            {
              "name": "meta.interpolation.zov",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.zov" }},
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.zov" }},
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.zov",
          "match": "'(\\\\.|[^'\\\\])'",
          "captures": { "0": { "patterns": [{ "include": "#char_escape" }]}}
        }
      ]
    },
    "char_escape": {
      "patterns": [
        {
          "name": "constant.character.escape.zov",
          "match": "\\\\(x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zov",
          "match": "\\b[0-9]+\\.[0-9]+(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.hex.zov",
          "match": "\\b0[xX][0-9a-fA-F]+(u8|u16|u32|u64|usize|i8|i16|i32|i64|isize)?\\b"
        },
        {
          "name": "constant.numeric.integer.zov",
          "match": "\\b[0-9]+(u8|u16|u32|u64|usize|i8|i16|i32|i64|isize|f32|f64)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.zov",
          "match": "\\b(void|i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|char|str)\\b"
        },
        {
          "name": "storage.type.other.zov",
          "match": "\\b(struct|enum|resource|nullable)\\b"
        },
        {
          "name": "entity.name.type.zov",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zov",
          "match": "\\b(if|else|while|for|in|return|break|continue|match|case|defer)\\b"
        },
        {
          "name": "keyword.other.declaration.zov",
          "match": "\\b(fn|let|mut|type|use|as|export|test)\\b"
        },
        {
          "name": "keyword.operator.logical.zov",
          "match": "\\borelse\\b"
        },
        {
          "name": "keyword.operator.misc.zov",
          "match": "\\b(null|true|false|assert|sizeof|hashval|hash_val|fromowned)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.zov",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.zov",
          "match": "\\+=|-=|\\*=|/=|%=|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.zov",
          "match": "&=|\\|=|\\^=|<<=|>>=|&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.logical.zov",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.other.zov",
          "match": "\\?|=>|\\.\\.|::"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.null.zov",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.boolean.zov",
          "match": "\\btrue\\b|\\bfalse\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.bracket.curly.zov", "match": "[{}]" },
        { "name": "punctuation.bracket.round.zov", "match": "[()]" },
        { "name": "punctuation.bracket.square.zov", "match": "\\[|\\]" },
        { "name": "punctuation.terminator.zov", "match": ";" },
        { "name": "punctuation.separator.zov", "match": "[,.:]" },
        { "name": "punctuation.assignment.zov", "match": "=" }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.zov",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b(?=\\s*:)"
        },
        { "include": "#types" }
      ]
    }
  }
}
