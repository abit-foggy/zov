<idea-plugin>
    <id>dev.zov</id>
    <name>Zov</name>
    <vendor>abit-foggy</vendor>

    <description><![CDATA[
        Zov language support for CLion, IntelliJ IDEA Ultimate, and other
        IntelliJ-platform IDEs. Provides native syntax highlighting for the
        full v1.2.0 grammar (string interpolation, hex/float literals with
        type suffixes, block comments), paired-brace matching, comment
        support, and full zov-lsp integration for diagnostics, completion,
        hover, folding, and structure view.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Zov"
                  language="Zov"
                  extensions="zov"
                  implementationClass="zov.idea.ZovFileType"
                  fieldName="INSTANCE"/>
        <lang.syntaxHighlighterFactory
                language="Zov"
                implementationClass="zov.idea.ZovSyntaxHighlighterFactory"/>
        <lang.commenter
                language="Zov"
                implementationClass="zov.idea.ZovCommenter"/>
        <lang.braceMatcher
                language="Zov"
                implementationClass="zov.idea.ZovBraceMatcher"/>
    </extensions>

    <extensions>
        <com.intellij.platform.lsp.integrationProvider
                implementation="zov.idea.ZovLspIntegrationProvider"/>
    </extensions>
</idea-plugin>
